<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Booking Confirmation - {{booking_reference_id}}</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: -apple-system, Arial, sans-serif;
      color: #1a1a2e;
      font-size: 14px;
      line-height: 1.6;
      background: #f5f6f8;
      padding: 20px;
    }
    .container { max-width: 600px; margin: 0 auto; background: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 2px 20px rgba(0,0,0,0.08); }
    .header { background: #1b2a4a; padding: 25px 30px; text-align: center; }
    .header h1 { color: #ffffff; font-size: 24px; margin: 0; }
    .header p { color: #cdd6e8; margin: 5px 0 0; }
    .content { padding: 25px 30px; }
    .section { margin-bottom: 20px; }
    .section-title { font-size: 15px; font-weight: 700; color: #1b2a4a; border-bottom: 2px solid #eee; padding-bottom: 8px; margin-bottom: 12px; }
    .row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #f5f5f5; font-size: 13px; }
    .label { color: #888; }
    .value { font-weight: 600; color: #1a1a2e; text-align: right; }
    .qr-container { text-align: center; padding: 20px; background: #f8f9fa; border-radius: 8px; margin: 10px 0; }
    .qr-container img { max-width: 150px; height: auto; }
    .badge { display: inline-block; padding: 4px 16px; border-radius: 50px; font-size: 12px; font-weight: 700; background: #e4f7f0; color: #1a8a6b; }
    .footer { text-align: center; padding: 18px 30px; color: #888; font-size: 12px; border-top: 1px solid #eee; background: #fafbfc; }
    .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 4px 20px; }
    @media only screen and (max-width: 480px) {
      body { padding: 10px; }
      .content { padding: 16px; }
      .header { padding: 18px 16px; }
      .grid-2 { grid-template-columns: 1fr; }
      .row { flex-direction: column; align-items: flex-start; }
      .value { text-align: left; margin-top: 2px; }
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Booking Confirmation</h1>
      <p>Siam Journeys Bangkok</p>
    </div>
    
    <div class="content">
      <!-- Status -->
      <div style="text-align: center; margin-bottom: 20px;">
        <span class="badge">{{booking_status}}</span>
      </div>
      
      <!-- Booking Summary -->
      <div class="section">
        <div class="section-title">Booking Summary</div>
        <div class="grid-2">
          <div class="row"><span class="label">Order ID:</span> <span class="value">{{booking_reference_id}}</span></div>
          <div class="row"><span class="label">Tour:</span> <span class="value">{{tour_name}}</span></div>
          <div class="row"><span class="label">Date:</span> <span class="value">{{tour_date}}</span></div>
          <div class="row"><span class="label">Package:</span> <span class="value">{{package_type}}</span></div>
          <div class="row"><span class="label">Guests:</span> <span class="value">{{quantity}}</span></div>
          <div class="row"><span class="label">Voucher:</span> <span class="value">{{voucher_number}}</span></div>
        </div>
      </div>
      
      <!-- QR Code -->
      <div class="qr-container">
        <img src="{{qr_code_url}}" alt="QR Code">
        <p style="margin-top: 8px; font-size: 12px; color: #888;">Scan this QR code at check-in</p>
        <p style="font-weight: 700; color: #1b2a4a;">{{voucher_number}}</p>
      </div>
      
      <!-- Customer -->
      <div class="section">
        <div class="section-title">Customer Information</div>
        <div class="grid-2">
          <div class="row"><span class="label">Name:</span> <span class="value">{{customer_name}}</span></div>
          <div class="row"><span class="label">Email:</span> <span class="value">{{customer_email}}</span></div>
          <div class="row"><span class="label">Phone:</span> <span class="value">{{customer_phone}}</span></div>
          <div class="row"><span class="label">Country:</span> <span class="value">{{customer_country}}</span></div>
        </div>
      </div>
      
      <!-- Accommodation -->
      <div class="section">
        <div class="section-title">Accommodation</div>
        <div class="grid-2">
          <div class="row"><span class="label">Hotel:</span> <span class="value">{{hotel_name}}</span></div>
          <div class="row"><span class="label">Address:</span> <span class="value">{{hotel_address}}</span></div>
          <div class="row"><span class="label">Room:</span> <span class="value">{{hotel_room}}</span></div>
        </div>
      </div>
      
      <!-- Pickup -->
      <div class="section">
        <div class="section-title">Pick-up Information</div>
        <div class="grid-2">
          <div class="row"><span class="label">Location:</span> <span class="value">{{pickup_location}}</span></div>
          <div class="row"><span class="label">Time:</span> <span class="value">{{pickup_time}}</span></div>
        </div>
      </div>
      
      <!-- Emergency -->
      <div class="section">
        <div class="section-title">Emergency Contact</div>
        <div class="grid-2">
          <div class="row"><span class="label">Name:</span> <span class="value">{{emergency_name}}</span></div>
          <div class="row"><span class="label">Phone:</span> <span class="value">{{emergency_phone}}</span></div>
          <div class="row"><span class="label">Email:</span> <span class="value">{{emergency_email}}</span></div>
          <div class="row"><span class="label">Relationship:</span> <span class="value">{{emergency_relation}}</span></div>
        </div>
      </div>
      
      <!-- Payment -->
      <div class="section">
        <div class="section-title">Payment</div>
        <div class="grid-2">
          <div class="row"><span class="label">Total Amount:</span> <span class="value" style="font-size:20px; font-weight:700; color:#1b2a4a;">{{total_price}}</span></div>
          <div class="row"><span class="label">Status:</span> <span class="value">{{payment_status}}</span></div>
        </div>
      </div>
      
      <!-- Cancellation -->
      <div class="section">
        <div class="section-title">Cancellation Policy</div>
        <p style="font-size:13px; color:#555; line-height:1.7;">{{cancellation_policy_text}}</p>
        <p style="font-size:12px; color:#888; margin-top:5px;">Cancellation deadline: {{cancellation_deadline}}</p>
      </div>
      
      <!-- Contact -->
      <div class="section">
        <div class="section-title">Need Help?</div>
        <div class="grid-2">
          <div class="row"><span class="label">Operator:</span> <span class="value">{{operator_name}}</span></div>
          <div class="row"><span class="label">Phone:</span> <span class="value">{{operator_phone}}</span></div>
          <div class="row"><span class="label">Email:</span> <span class="value">{{operator_email}}</span></div>
          <div class="row"><span class="label">Website:</span> <span class="value">{{operator_website}}</span></div>
        </div>
        <p style="font-size:12px; color:#888; margin-top:8px;">{{support_note}}</p>
      </div>
    </div>
    
    <div class="footer">
      <p>&copy; 2026 Siam Journeys Bangkok. All rights reserved.</p>
      <p style="font-size:11px; color:#aaa;">Order #{{booking_reference_id}}</p>
    </div>
  </div>
</body>
</html>