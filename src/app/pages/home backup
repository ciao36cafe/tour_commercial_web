// ─── SHARED MICRO-COMPONENTS ──────────────────────────────────────────────────
function Label({ children }: { children: React.ReactNode }) {
  return <p className="text-[11px] tracking-[0.22em] uppercase font-medium mb-4 text-[#B8952A]">{children}</p>;
}

function Rule({ center = false }: { center?: boolean }) {
  return <div className={`w-10 h-px bg-[#B8952A] mb-6 ${center ? "mx-auto" : ""}`} />;
}

function Stars({ n }: { n: number }) {
  return (
    <div className="flex gap-0.5">
      {Array.from({ length: n }).map((_, i) => (
        <Star key={i} size={13} className="fill-[#B8952A] text-[#B8952A]" />
      ))}
    </div>
  );
}

function CategoryBadge({ category }: { category: string }) {
  const map: Record<string, { bg: string; text: string; label: string }> = {
    morning: { bg: "bg-amber-50", text: "text-amber-700", label: "Morning" },
    nightlife: { bg: "bg-indigo-50", text: "text-indigo-700", label: "Nightlife" },
    cultural: { bg: "bg-emerald-50", text: "text-emerald-700", label: "Cultural" },
    local: { bg: "bg-orange-50", text: "text-orange-700", label: "Local Explore" },
  };
  const c = map[category] || { bg: "bg-stone-50", text: "text-stone-600", label: category };
  return (
    <span className={`text-[9px] tracking-[0.18em] uppercase font-semibold px-2 py-0.5 ${c.bg} ${c.text}`}>
      {c.label}
    </span>
  );
}

